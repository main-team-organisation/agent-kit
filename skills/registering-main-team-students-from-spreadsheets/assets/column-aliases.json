    "full_name": ["full name", "fullname", "student name", "name surname", "ad soyad", "adi soyadi", "name"],
    "birth": ["birth", "date of birth", "birth date", "birthdate", "birthday", "dob", "geburtsdatum", "date de naissance", "fecha de nacimiento", "dogum tarihi", "data urodzenia"],
    "sex": ["sex", "gender", "geschlecht", "sexe", "genero", "sexo", "cinsiyet", "plec"],
    "email": ["email", "e-mail", "email address", "mail", "e posta", "eposta"],
